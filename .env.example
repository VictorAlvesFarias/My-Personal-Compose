# Copy to .env and fill in the passwords and keys (.env is not versioned).
# Strong values: openssl rand -hex 32 (JWT keys: openssl rand -hex 64)   (or [guid]::NewGuid().ToString('N') twice in PowerShell)

# ------------------------------------------------------------------ storage
# Where the data folders live, as seen by Docker in its WSL distro (/mnt/d/volumes is D:olumes).
VOLUMES_ROOT=/mnt/d/volumes

# ------------------------------------------------------------------ PostgreSQL (shared)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# Each application has its own user and database on the server above.
SAFEGUARD_DB_PASSWORD=
GAMEOUT_DB_PASSWORD=

# ------------------------------------------------------------------ RabbitMQ (shared)
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ------------------------------------------------------------------ MinIO (shared)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ------------------------------------------------------------------ Safeguard
# JWT signing key (HMAC-SHA512): at least 64 characters. Changing it signs everyone out.
SAFEGUARD_JWT_KEY=
SAFEGUARD_API_PORT=8101
SAFEGUARD_WEB_PORT=8100
# Address the browser uses to reach the API.
SAFEGUARD_API_URL=http://localhost:8101

# ------------------------------------------------------------------ Gameout
# JWT signing key: at least 64 characters (HMAC-SHA512).
GAMEOUT_JWT_KEY=
GAMEOUT_API_PORT=8201
GAMEOUT_WEB_PORT=8200
GAMEOUT_API_URL=http://localhost:8201
GAMEOUT_WS_URL=ws://localhost:8201/ws
# Host and port in the presigned download/upload URLs (what the browser and Gameout-Driver reach).
GAMEOUT_MINIO_PUBLIC_ENDPOINT=localhost:9000
GAMEOUT_SWAGGER=true
